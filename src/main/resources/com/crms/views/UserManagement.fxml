<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.geometry.Insets?>

<VBox fx:controller="com.crms.controller.UserManagementController"
      prefHeight="650.0" prefWidth="950.0" spacing="15.0" style="-fx-padding: 20;"
      xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21">

    
    <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="User Management" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Pane HBox.hgrow="ALWAYS" /> <!-- Fills space to push button to the right -->
                <Button text="Back to Dashboard" onAction="#handleBack" style="-fx-padding: 5 15;" />
    </HBox>

    <SplitPane dividerPositions="0.6" VBox.vgrow="ALWAYS">
        
        <VBox spacing="10.0" style="-fx-padding: 5;">
            <Label text="All System Users" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <TableView fx:id="usersTableView" VBox.vgrow="ALWAYS">
                </TableView>
            <HBox spacing="10.0" alignment="BOTTOM_LEFT">
                <Button text="Load Selected for Edit" onAction="#loadSelectedUser"/>
                <Button text="Deactivate User" onAction="#handleDeactivateUser" style="-fx-background-color: #f0ad4e; -fx-text-fill: white;"/>
            </HBox>
        </VBox>

        <VBox spacing="20.0" style="-fx-padding: 10;">
            <TitledPane text="Add / Edit User Details" collapsible="false">
                <GridPane hgap="10.0" vgap="15.0" style="-fx-padding: 10;">
                    
                    <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="User ID:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="userIdField" promptText="System-Generated or Manual ID" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Role:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <ComboBox fx:id="roleComboBox" promptText="Select Role" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity"/>

                    <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <TextField fx:id="passwordField" promptText="Set initial password" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    
                    <Button fx:id="saveButton" text="Save / Update User" onAction="#handleSaveUser" 
                            style="-fx-background-color: #28a745; -fx-text-fill: white;" 
                            GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                            
                </GridPane>
            </TitledPane>
            
            <Button text="Clear Form" onAction="#handleClearForm"/>
        </VBox>
    </SplitPane>
</VBox>