<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextField?>


<VBox fx:controller="com.crms.controller.ReportsAuditController"
      prefHeight="700.0" prefWidth="1000.0" spacing="15.0" style="-fx-padding: 20;"
      xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21">

    
    <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="System Reports &amp; Audit Logs" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Pane HBox.hgrow="ALWAYS" /> <!-- Fills space to push button to the right -->
                <Button text="Back to Dashboard" onAction="#handleBack" style="-fx-padding: 5 15;" />
    </HBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="Audit Logs">
            <VBox spacing="10.0" style="-fx-padding: 25;">
                <Label text="System Activity and User Actions" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Filter By User ID:"/>
                    <TextField fx:id="auditUserFilterField" promptText="Enter User ID" />
                    <Button text="Filter" onAction="#handleFilterAuditLog"/>
                </HBox>
                
                <TableView fx:id="auditLogTable" VBox.vgrow="ALWAYS" prefHeight="500.0">
                    </TableView>
            </VBox>
        </Tab>

        <Tab text="Crime Reports">
            <VBox spacing="15.0" style="-fx-padding: 25;">
                <Label text="Pending Crime Reports (Filed by Officers)" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <TableView fx:id="crimeReportsTable" prefHeight="400.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="reportIdCol" text="Report ID" prefWidth="80.0"/>
                        <TableColumn fx:id="crimeTypeCol" text="Crime Type" prefWidth="180.0"/>
                        <TableColumn fx:id="officerCol" text="Officer ID" prefWidth="120.0"/>
                        <TableColumn fx:id="statusCol" text="Status" prefWidth="100.0"/>
                        <TableColumn fx:id="createdCol" text="Created At" prefWidth="160.0"/>
                    </columns>
                </TableView>

                <Button text="Register Selected Report as Case"
                        onAction="#handleRegisterCase"
                        style="-fx-background-color: #28a745; -fx-text-fill: white;"/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>