<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToolBar?>

<BorderPane fx:controller="com.crms.controller.CaseManagementController"
            prefHeight="650.0" prefWidth="900.0"
            xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21">
    
    <top>
        <VBox spacing="10.0" style="-fx-padding: 15; -fx-background-color: #eee;">
            <Label text="Case Management" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Current Case ID:"/>
                <Label fx:id="caseIdLabel" text="[ID HERE]" style="-fx-font-weight: bold;"/>
                <Label text="Title:"/>
                <TextField fx:id="caseTitleField" promptText="Case Title" prefWidth="300.0"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="caseTabPane" prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE">
            
            <Tab text="Details &amp; Status">
                <VBox spacing="20.0" style="-fx-padding: 25;">
                    <GridPane hgap="15.0" vgap="15.0">
                        <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <ComboBox fx:id="statusComboBox" promptText="Select Status" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="200.0" />
                        
                        <Label text="Assigned Officer:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <ComboBox fx:id="officerComboBox" promptText="Assign Officer" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="200.0" />
                        
                        <Label text="Report Details:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextArea fx:id="reportDetailsArea" promptText="Summary of linked crime reports..." prefRowCount="4" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Log/Notes:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <TextArea fx:id="logNotesArea" promptText="Enter investigation notes and actions taken..." prefRowCount="4" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    </GridPane>
                    
                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <Button text="Update Case Status" onAction="#handleUpdateStatus" style="-fx-padding: 8 15; -fx-background-color: #007bff; -fx-text-fill: white;"/>
                        <Button text="Close Case" onAction="#handleCloseCase" style="-fx-padding: 8 15; -fx-background-color: #dc3545; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>
            </Tab>

            <Tab text="Suspects">
                <VBox spacing="10.0" style="-fx-padding: 25;">
                    <ToolBar>
                        <Label text="Suspects Linked to Case:"/>
                        <Button text="Add New Suspect" onAction="#handleAddSuspect" />
                    </ToolBar>
                    
                    <TableView fx:id="suspectsTable" prefHeight="300.0">
                        </TableView>
                    
                    <Button text="View Suspect Details/History" onAction="#handleViewSuspectDetails" />
                </VBox>
            </Tab>
            
        </TabPane>
    </center>
</BorderPane>